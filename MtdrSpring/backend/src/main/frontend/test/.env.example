# Base URL of the running app (Spring Boot serving the bundled frontend)
BASE_URL=http://localhost:8080

# Manager credentials used by the e2e test.
# The /api/auth/login and /api/auth/verify-otp endpoints are mocked by
# the test, so any non-empty values are accepted — but matching the real
# user keeps the test readable.
MANAGER_EMAIL=managertest468@gmail.com
MANAGER_PASSWORD=demo_manager

# Name (case sensitive) of the developer to inspect in the KPI dashboard
TARGET_DEVELOPER_NAME=Developer Test
